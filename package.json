{
    "name": "clubify",
    "version": "0.1.0",
    "private": true,
    "description": "Spotify-only nightclub DSP for Windows",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "engine": "tsx src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "ui:dev": "vite --config ui/vite.config.ts",
        "ui:build": "vite build --config ui/vite.config.ts",
        "dev:all": "concurrently -k -n engine,ui \"npm:engine\" \"npm:ui:dev\"",
        "desktop:dev": "tauri dev",
        "package:engine": "npm run build && node scripts/package-engine.mjs",
        "desktop:build": "npm run package:engine && tauri build",
        "build:capture": "node vendor/loopback-capture/scripts/build-native.mjs",
        "ui:typecheck": "node scripts/ui-typecheck.cjs -p ui/tsconfig.json --noEmit",
        "version:bump": "node scripts/bump-version.mjs"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "audify": "^1.10.1",
        "loopback-capture": "file:vendor/loopback-capture",
        "pinia": "^4.1.0",
        "vue": "^3.5.46",
        "ws": "^8.23.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.6",
        "@types/node": "^26.6.10",
        "@types/ws": "^8.18.2",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-vue": "^6.0.11",
        "concurrently": "^10.0.7",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.2",
        "vue-tsc": "^3.3.14"
    }
}
