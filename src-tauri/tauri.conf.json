{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clubify",
  "version": "0.2.0",
  "identifier": "com.clubify.audio",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clubify",
        "width": 1180,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tall1on/clubify/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OUVFQ0U2RUYzQjA5OEEKUldTS0NUdnY1dXllaElhSng4OW5INXA4YWJQcmpsQVdQUkxiZWRoekk5Tm1WNlBRVWZjOVhHSWsK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Luke Grandke",
    "copyright": "Copyright (c) 2026 Luke Grandke",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "resources/node.exe": "node.exe",
      "resources/NODE-LICENSE": "NODE-LICENSE",
      "resources/engine": "engine"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
